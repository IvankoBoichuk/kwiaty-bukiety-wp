DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_PREFIX='wp_'
# DB_SSL=true

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Overrides WP_ENV for WordPress' own notion of the environment
# (production | staging | development | local)
# WP_ENVIRONMENT_TYPE='staging'

# Production defaults to true; run wp-cron.php from a system cron instead.
# DISABLE_WP_CRON=true

# Production caps revisions at 10. Set false to disable them entirely.
# WP_POST_REVISIONS=10

# Mail for letters from non-production env
MAIL_REDIRECT_TO=your-address@example.com

# Hostinger API, for mirroring Redirection's plain 301s into server-level
# redirects (web/app/mu-plugins/hostinger-redirects). Create the token in
# hPanel under Account → API; an empty token switches the mirror off.
# HOSTINGER_API_TOKEN=''

# Optional. The hosting account the domain sits in -- the same value as the
# `hostinger_account` secret in Woodpecker. Looked up from the API when empty.
# HOSTINGER_ACCOUNT=''

# Optional. Defaults to the host of WP_HOME.
# HOSTINGER_SITE_DOMAIN='example.com'

# Mirroring only runs in production. Set this to mirror from another
# environment on purpose -- it writes to the live hosting account.
# HOSTINGER_REDIRECTS_ENABLED=true

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
