# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Composer installs vendor mu-plugins as directories; ours are single files,
# except the Hostinger redirect mirror, which is too big for one.
web/app/mu-plugins/*/
!web/app/mu-plugins/hostinger-redirects/
web/app/themes/*/
!web/app/themes/sage
web/app/upgrade
web/app/backups-dup-lite
web/app/languages
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
**/vendor
auth.json

# WP-CLI
wp-cli.local.yml
.vscode

/wp-includes

/layout
.htaccess

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

.devcontainer
**/node_modules/
/package-lock.json
# Playwright/Lighthouse perf gate (reports only; baselines are committed)
tests/perf/.reports/
