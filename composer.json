{
  "name": "kwiaty-bukiety/bedrock",
  "type": "project",
  "license": "MIT",
  "version": "0.1.0",
  "description": "WordPress site for flowers delivery built with Bedrock",
  "homepage": "https://kwiaty-bukiety.com.pl/",
  "authors": [
    {
      "name": "Ivan Boichuk",
      "email": "ivan.boychuck@gmail.com",
      "homepage": "https://github.com/IvankoBoichuk"
    }
  ],
  "repositories": {
    "wp-packages": {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    "frontenda-blocks": {
      "type": "vcs",
      "url": "https://github.com/IvankoBoichuk/frontenda-blocks"
    }
  },
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^7.0.0",
    "roots/wp-config": "1.0.0",
    "wp-plugin/woocommerce": "^11.1",
    "wp-plugin/loco-translate": "^2.8",
    "roots/allow-svg": "^1.0",
    "wp-plugin/woo-payu-payment-gateway": "^2.10",
    "wp-plugin/woocommerce-paypal-payments": "^4.0.4",
    "roots/acorn": "^6.2",
    "generoi/sage-woocommerce": "^1.1",
    "timber/timber": "^2.5",
    "frontenda/frontenda-blocks": "^1.1",
    "wp-plugin/wordpress-seo": "^28.6"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "pestphp/pest": "^4.7",
    "wp-plugin/query-monitor": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "App\\": "web/app/themes/sage/app/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest",
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
