#: app/Admin/FuneralSettingsPage.php:38
#: app/Admin/FuneralSettingsPage.php:39
#: app/Admin/FuneralSettingsPage.php:137
msgid "Funeral settings"
msgstr "Ustawienia pogrzebowe"

#: app/Admin/FuneralSettingsPage.php:117
msgid "The ribbon message price must be a number of 0 or more; the previous price is kept."
msgstr "Cena treści szarfy musi być liczbą równą 0 lub większą; zachowano poprzednią cenę."

#: app/Admin/FuneralSettingsPage.php:140
msgid "What the wreath page offers on top of the wreath itself."
msgstr "Co strona wieńca oferuje oprócz samego wieńca."

#: app/Admin/FuneralSettingsPage.php:152
msgid "Add-on products"
msgstr "Produkty dodatkowe"

#: app/Admin/FuneralSettingsPage.php:162
msgid "Search for a product…"
msgstr "Wyszukaj produkt…"

#: app/Admin/FuneralSettingsPage.php:178
msgid "Offered under every wreath, in this order, and added to the cart as separate lines. Leave empty to offer none."
msgstr "Oferowane pod każdym wieńcem w tej kolejności i dodawane do koszyka jako osobne pozycje. Pozostaw puste, aby nie oferować żadnych."

#: app/Admin/FuneralSettingsPage.php:185
msgid "Ribbon message price"
msgstr "Cena treści szarfy"

#: app/Admin/FuneralSettingsPage.php:200
msgid "Added to the wreath price when the customer fills in the ribbon message. 0 makes the ribbon free. A cart that already holds a wreath keeps the price it was added at."
msgstr "Doliczana do ceny wieńca, gdy klient wpisze treść szarfy. 0 oznacza szarfę bezpłatną. Koszyk, w którym wieniec już jest, zachowuje cenę z chwili dodania."

