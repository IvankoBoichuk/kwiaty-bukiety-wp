#: app/Admin/OrderNotificationsSettingsPage.php:32
#: app/Admin/OrderNotificationsSettingsPage.php:33
#: app/Admin/OrderNotificationsSettingsPage.php:115
msgid "Order Notifications"
msgstr "Powiadomienia o zamówieniach"

#: app/Admin/OrderNotificationsSettingsPage.php:73
msgid "The partner e-mail address is not valid; the e-mail channel stays off."
msgstr "Adres e-mail partnera jest nieprawidłowy; kanał e-mail pozostaje wyłączony."

#: app/Admin/OrderNotificationsSettingsPage.php:83
msgid "The webhook URL is not valid; the webhook stays off."
msgstr "Adres URL webhooka jest nieprawidłowy; webhook pozostaje wyłączony."

#: app/Admin/OrderNotificationsSettingsPage.php:93
msgid "The Google Sheets URL is not valid; the sync stays off."
msgstr "Adres URL Google Sheets jest nieprawidłowy; synchronizacja pozostaje wyłączona."

#: app/Admin/OrderNotificationsSettingsPage.php:118
msgid "Sent once when an order moves to \"processing\". Leave a field empty to switch that channel off."
msgstr "Wysyłane raz, gdy zamówienie przechodzi w stan „w realizacji”. Pozostaw pole puste, aby wyłączyć dany kanał."

#: app/Admin/OrderNotificationsSettingsPage.php:128
msgid "Partner e-mail"
msgstr "E-mail partnera"

#: app/Admin/OrderNotificationsSettingsPage.php:140
msgid "Receives the fulfilment e-mail with the order details and the partner price."
msgstr "Otrzymuje e-mail realizacyjny ze szczegółami zamówienia i ceną partnerską."

#: app/Admin/OrderNotificationsSettingsPage.php:147
msgid "Make.com webhook URL"
msgstr "Adres URL webhooka Make.com"

#: app/Admin/OrderNotificationsSettingsPage.php:160
msgid "The order is posted here as JSON."
msgstr "Zamówienie jest wysyłane tutaj w formacie JSON."

#: app/Admin/OrderNotificationsSettingsPage.php:167
msgid "Google Sheets web app URL"
msgstr "Adres URL aplikacji internetowej Google Sheets"

#: app/Admin/OrderNotificationsSettingsPage.php:180
msgid "Orders entering processing, completed, cancelled or refunded are appended to the sheet. Leave empty on a copy of the site: that is what keeps it out of the live spreadsheet."
msgstr "Zamówienia przechodzące w realizację, zrealizowane, anulowane lub zwrócone są dopisywane do arkusza. Pozostaw puste na kopii witryny — dzięki temu nie trafią do produkcyjnego arkusza."

