#: app/Admin/OrderNotificationsSettingsPage.php:34
#: app/Admin/OrderNotificationsSettingsPage.php:35
#: app/Admin/OrderNotificationsSettingsPage.php:119
msgid "Order Notifications"
msgstr "Powiadomienia o zamówieniach"

#: app/Admin/OrderNotificationsSettingsPage.php:77
msgid "The partner e-mail address is not valid; the e-mail channel stays off."
msgstr "Adres e-mail partnera jest nieprawidłowy; kanał e-mail pozostaje wyłączony."

#: app/Admin/OrderNotificationsSettingsPage.php:87
msgid "The webhook URL is not valid; the webhook stays off."
msgstr "Adres URL webhooka jest nieprawidłowy; webhook pozostaje wyłączony."

#: app/Admin/OrderNotificationsSettingsPage.php:122
msgid "Sent once when an order moves to \"processing\". Leave a field empty to switch that channel off."
msgstr "Wysyłane raz, gdy zamówienie przechodzi w stan „w realizacji”. Pozostaw pole puste, aby wyłączyć dany kanał."

#: app/Admin/OrderNotificationsSettingsPage.php:132
msgid "Partner e-mail"
msgstr "E-mail partnera"

#: app/Admin/OrderNotificationsSettingsPage.php:144
msgid "Receives the fulfilment e-mail with the order details and the partner price."
msgstr "Otrzymuje e-mail realizacyjny ze szczegółami zamówienia i ceną partnerską."

#: app/Admin/OrderNotificationsSettingsPage.php:151
msgid "Make.com webhook URL"
msgstr "Adres URL webhooka Make.com"

#: app/Admin/OrderNotificationsSettingsPage.php:164
msgid "The order is posted here as JSON."
msgstr "Zamówienie jest wysyłane tutaj w formacie JSON."

#: app/Admin/ProductAttributeIcons.php:240
