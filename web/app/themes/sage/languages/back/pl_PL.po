#: app/Admin/DeliveryTimerSettingsPage.php:20
#: app/Admin/DeliveryTimerSettingsPage.php:21
msgid "Delivery Timer"
msgstr "Licznik dostawy"

#: app/Admin/DeliveryTimerSettingsPage.php:60
msgid "Delivery timer settings"
msgstr "Ustawienia licznika dostawy"

#: app/Admin/DeliveryTimerSettingsPage.php:65
msgid "Set the working hours, delivery time slots, and the list of additional holidays."
msgstr "Ustaw godziny pracy, przedziały czasowe dostaw oraz listę dodatkowych dni wolnych."

#: app/Admin/DeliveryTimerSettingsPage.php:81
msgid "Working hours on weekdays"
msgstr "Godziny pracy w dni powszednie"

#: app/Admin/DeliveryTimerSettingsPage.php:100
msgid "Format: 9-17"
msgstr "Format: 9-17"

#: app/Admin/DeliveryTimerSettingsPage.php:110
msgid "Working hours on weekends"
msgstr "Godziny pracy w weekendy"

#: app/Admin/DeliveryTimerSettingsPage.php:129
msgid "Format: 9-14. Applies on Saturday and Sunday."
msgstr "Format: 9-14. Obowiązuje w soboty i niedziele."

#: app/Admin/DeliveryTimerSettingsPage.php:139
msgid "Delivery time slots"
msgstr "Przedziały czasowe dostawy"

#: app/Admin/DeliveryTimerSettingsPage.php:157
msgid "Format: 08-12, 12-15, 15-18, 18-21. You can separate values by commas or new lines."
msgstr "Format: 08-12, 12-15, 15-18, 18-21. Wartości można oddzielać przecinkami lub nowymi liniami."

#: app/Admin/DeliveryTimerSettingsPage.php:167
msgid "Additional holidays"
msgstr "Dodatkowe dni wolne"

#: app/Admin/DeliveryTimerSettingsPage.php:185
msgid "Format: YYYY-MM-DD, separated by commas."
msgstr "Format: RRRR-MM-DD, oddzielone przecinkami."

#: app/Admin/DeliveryTimerSettingsPage.php:195
msgid "Save"
msgstr "Zapisz"

