#: app/Modules/LocalLinking/PopularOrderAdmin.php:51
msgid "Popular"
msgstr "Popularne"

#: app/Modules/LocalLinking/PopularOrderAdmin.php:99
msgid "Popular order"
msgstr "Kolejność popularnych"

#: app/Modules/LocalLinking/PopularOrderAdmin.php:101
msgid "Lower numbers come first in the \"popular cities\" block. Leave empty to order automatically."
msgstr "Niższe numery pojawiają się jako pierwsze w bloku „popularne miasta”. Pozostaw puste, aby uporządkować automatycznie."

#: app/Shop/OrderAdminColumns.php:48
msgid "NIP"
msgstr "NIP"

#: app/Admin/OrderNotificationsSettingsPage.php:97
msgid "That is not a Google Sheets ID or link; the sync stays off."
msgstr "To nie jest identyfikator ani link do arkusza Google Sheets; synchronizacja pozostaje wyłączona."

#: app/Admin/OrderNotificationsSettingsPage.php:171
msgid "Google Sheets spreadsheet"
msgstr "Arkusz Google Sheets"

#: app/Admin/OrderNotificationsSettingsPage.php:184
msgid "The spreadsheet link or its ID. Orders entering processing, completed or refunded are written to it, newest at the top; a cancelled order's row is removed. Only columns A-H are touched."
msgstr "Link do arkusza lub jego identyfikator. Zamówienia przechodzące w realizację, zrealizowane lub zwrócone są w nim zapisywane, najnowsze na górze; wiersz anulowanego zamówienia jest usuwany. Zmieniane są tylko kolumny A-H."

#: app/Admin/OrderNotificationsSettingsPage.php:191
msgid "Sheet tab"
msgstr "Karta arkusza"

#: app/Admin/OrderNotificationsSettingsPage.php:205
msgid "Service account"
msgstr "Konto usługi"

#: app/Admin/OrderNotificationsSettingsPage.php:210
msgid "Share the spreadsheet with this address as an editor."
msgstr "Udostępnij arkusz temu adresowi z uprawnieniami edytora."

#: app/Admin/OrderNotificationsSettingsPage.php:214
msgid "GOOGLE_SHEETS_CREDENTIALS is not set in this environment, so the sync is off. That is intended on a copy of the site: it keeps it out of the live spreadsheet."
msgstr "Zmienna GOOGLE_SHEETS_CREDENTIALS nie jest ustawiona w tym środowisku, więc synchronizacja jest wyłączona. Na kopii witryny tak ma być: dzięki temu nie trafia ona do produkcyjnego arkusza."

#: app/Shop/OrderSheetsSync.php:409
msgid "Send to Google Sheets"
msgstr "Wyślij do Google Sheets"

